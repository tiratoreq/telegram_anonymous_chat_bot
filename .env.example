# ==============================================================================
# КОНФИГУРАЦИЯ ЧАТ-БОТА (ANONYMOUS CHATBOT)
# ==============================================================================

# Токен для доступа к Telegram Bot API
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# После копирования файла в .env укажите реальные Telegram ID администраторов.
ADMIN_IDS="1,2,3"

# Путь к файлу базы данных SQLite
DB_PATH="bot.db"

# Максимальная длина сообщения для ответа в символах
MAX_MESSAGE_LEN=4096

# Максимальный лимит запросов на пользователя за окно (в памяти)
RATE_LIMIT_MAX=10

# Размер окна для проверки rate limit (в секундах)
RATE_LIMIT_WINDOW=15